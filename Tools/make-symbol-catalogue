#!/usr/bin/env python3
"""Writes Resources/SFSymbols.txt — the catalogue the board icon picker browses.

There is no public API that enumerates SF Symbols, so the list has to be
shipped. It is *generated* rather than typed, out of the same CoreGlyphs bundle
the system draws from, so it cannot drift from what `Image(systemName:)` will
actually render on the deployment target:

    Tools/make-symbol-catalogue                # writes Resources/SFSymbols.txt
    Tools/make-symbol-catalogue --out FILE     # somewhere else, to diff a change

What is left out, and why:

  * Anything newer than the deployment target (iOS/macOS 26.0). A name the
    running system has never heard of draws nothing at all, and a picker whose
    swatches are blank is worse than one that is a symbol short.
  * The 663 restricted marks — Apple's own logos, product and service glyphs,
    which "may not be modified and may only be used to refer to" the thing they
    name. A board called Groceries wearing the iCloud mark is exactly the use
    the restriction forbids.
  * The four rendering traits CoreGlyphs files beside the real categories —
    `multicolor`, `variable`, `whatsnew` and `draw`. They say how a glyph can
    be *drawn*, not what it is of, and the picker browses by subject.
  * The localized numeral variants (`0.circle.ar`, `1.calendar.hi`, …) and the
    `.rtl`/`.ltr` pairs. The system substitutes these itself for the reader's
    language and writing direction; offered by name they are a thousand rows of
    digits nobody browsing for a board icon is looking for.

Re-run it after an OS upgrade and commit the diff, which is what a new year of
symbols looks like.
"""

import argparse
import plistlib
import re
import sys
from pathlib import Path

GLYPHS = Path(
    "/System/Library/CoreServices/CoreGlyphs.bundle/Contents/Resources"
)

# The deployment target in project.yml. A symbol released after this exists in
# the SF Symbols app and not on the oldest system the app runs on.
DEPLOYMENT = (26, 0)

# Traits rather than subjects — see the module note.
NOT_SUBJECTS = {"all", "multicolor", "variable", "whatsnew", "draw"}

# `0.circle.ar`, `1.calendar.hi`, `homepod.badge.checkmark.rtl` — see the
# module note. The suffix is always last or second to last.
LOCALIZED = re.compile(
    r"\.(ar|hi|he|ja|ko|th|zh|my|km|si|ta|te|kn|ml|gu|pa|bn|or|mr|ne|sat|deva"
    r"|ur|fa|ku|rtl|ltr)(\.|$)"
)


def release(pair):
    major, _, minor = pair.partition(".")
    return (int(major), int(minor or 0))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", default="Resources/SFSymbols.txt")
    args = parser.parse_args()

    if not GLYPHS.is_dir():
        sys.exit(f"no CoreGlyphs bundle at {GLYPHS}")

    availability = plistlib.loads((GLYPHS / "name_availability.plist").read_bytes())
    years = {
        year: rel
        for year, rel in availability["year_to_release"].items()
        if release(rel["iOS"]) <= DEPLOYMENT and release(rel["macOS"]) <= DEPLOYMENT
    }
    restricted = set(plistlib.loads((GLYPHS / "symbol_restrictions.strings").read_bytes()))
    categories = plistlib.loads((GLYPHS / "symbol_categories.plist").read_bytes())
    search = plistlib.loads((GLYPHS / "symbol_search.plist").read_bytes())

    names = sorted(
        name
        for name, year in availability["symbols"].items()
        if year in years and name not in restricted and not LOCALIZED.search(name)
    )

    lines = [
        "# The SF Symbols the board icon picker offers, generated by",
        "# Tools/make-symbol-catalogue — do not edit by hand.",
        "#",
        "# name<TAB>categories, comma separated<TAB>search terms, space separated.",
        "# The two trailing fields may be empty; the categories are the keys in",
        "# SymbolCatalog.Category, and a symbol in none of them is reachable by",
        "# search and under All.",
    ]
    for name in names:
        cats = ",".join(sorted(set(categories.get(name, [])) - NOT_SUBJECTS))
        terms = " ".join(sorted(search.get(name, [])))
        lines.append(f"{name}\t{cats}\t{terms}".rstrip("\t"))

    out = Path(args.out)
    out.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"{len(names)} symbols → {out} ({out.stat().st_size:,} bytes)")


if __name__ == "__main__":
    main()
