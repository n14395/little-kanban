<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS sandboxes every app, so the `com.apple.security.*` keys the macOS
	     file carries have nothing to say here and provisioning complains about
	     some of them. What both platforms need is the same two things: the
	     container SwiftData syncs through, and the push that tells the app
	     another device changed something. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.n14395.Cardstock</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<!-- The one piece of disk the app and its widget extension both hold. The
	     widgets are drawn from a digest written here — see WidgetShare — and a
	     bundle without this joins no group, finds no container, and publishes
	     nothing. macOS insists the identifier begins with the team id;
	     iOS insists it does not, which is why the two files disagree. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.n14395.Cardstock</string>
	</array>
</dict>
</plist>
