<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every app extension on macOS is sandboxed whether it says so or not;
	     saying so is what lets the group below be granted. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The captures folder, and nothing else. No network, no iCloud container,
	     no reach at the board file: the extension writes one small JSON file
	     into the group and the app drains it. See CaptureInbox. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>P52946XHRJ.group.com.n14395.SimpleKanban</string>
	</array>
</dict>
</plist>
