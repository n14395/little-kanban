<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- No network client: this is the sync-off build, and nothing in it makes
	     an outbound connection. -->
	<!-- The one piece of disk the app and its widget extension both hold. The
	     widgets are drawn from a digest written here — see WidgetShare — and a
	     bundle without this joins no group, finds no container, and publishes
	     nothing. macOS insists the identifier begins with the team id;
	     iOS insists it does not, which is why the two files disagree. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>P52946XHRJ.group.com.n14395.Cardstock</string>
	</array>
</dict>
</plist>
