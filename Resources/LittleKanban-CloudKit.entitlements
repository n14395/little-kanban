<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- For sync, and nothing else: CloudKit is the one thing here that goes
	     out on the network. A sandboxed app with no client entitlement gets a
	     connection refused it cannot explain. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Sync. SwiftData finds its database through the ubiquity container
	     named here; `BoardSyncStore` names the same one explicitly rather than
	     taking whichever comes first, so adding a second container later
	     cannot silently move the board. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.n14395.LittleKanban</string>
	</array>
	<!-- CloudKit tells the app about a change on another device by pushing a
	     silent notification; without this the board only catches up on the
	     mirror's own polling cadence, which is minutes. And on macOS the key
	     carries the com.apple.developer. prefix — the bare `aps-environment`
	     is iOS's spelling, and writing it here handed this app no push
	     entitlement at all, which is exactly what those minutes looked like.

	     `development` here because this file is the *development* build's and
	     has to match its Apple Development profile. The Developer ID release
	     does not ship it: build.sh's signing pass pins this to `production`
	     and pins `icloud-container-environment` to `Production` beside it, so
	     a distributed copy can never be pointed at the development side of
	     CloudKit. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- The one piece of disk the app and its widget extension both hold. The
	     widgets are drawn from a digest written here — see WidgetShare — and a
	     bundle without this joins no group, finds no container, and publishes
	     nothing. macOS insists the identifier begins with the team id;
	     iOS insists it does not, which is why the two files disagree. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>P52946XHRJ.group.com.n14395.LittleKanban</string>
	</array>
</dict>
</plist>
